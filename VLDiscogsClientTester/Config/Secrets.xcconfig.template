// Secrets.xcconfig.template
//
// Template for local Discogs API credentials.
//
// Setup:
//   1. Copy this file to Secrets.xcconfig (same directory).
//   2. Fill in the values from your Discogs developer application
//      (https://www.discogs.com/settings/developers).
//   3. Secrets.xcconfig is gitignored, so your credentials stay out of source control.
//
// Xcode reads Secrets.xcconfig as the base configuration for the app target and
// substitutes these values into Info.plist. The Secrets accessor reads them at runtime.

DISCOGS_CONSUMER_KEY = YOUR_DISCOGS_CONSUMER_KEY
DISCOGS_CONSUMER_SECRET = YOUR_DISCOGS_CONSUMER_SECRET
